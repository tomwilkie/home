{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "labels": ["dependencies"],
  "git-submodules": {
    "enabled": true
  },
  "packageRules": [
    {
      "description": "Commit messages follow the repo convention: <area>: <lowercase summary>",
      "matchFileNames": ["observability/**"],
      "commitMessagePrefix": "observability:"
    },
    {
      "description": "ESPHome device repos vendored as submodules under esphome/",
      "matchManagers": ["git-submodules"],
      "matchDepNames": ["esphome/**"],
      "commitMessagePrefix": "esphome:"
    },
    {
      "description": "unpoller/dashboards has no releases, so every commit to its master opens a PR. Deploy with `make unpoller-dashboards`",
      "matchManagers": ["git-submodules"],
      "matchDepNames": ["observability/dashboards/unpoller"],
      "commitMessagePrefix": "observability:"
    }
  ]
}
