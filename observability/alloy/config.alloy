// ── Grafana Cloud stack ───────────────────────────────────────────────────────
import.git "grafana_cloud" {
  repository     = "https://github.com/grafana/alloy-modules.git"
  path           = "modules/cloud/grafana/cloud/module.alloy"
  revision       = "021e920"
  pull_frequency = "0s"
}

grafana_cloud.stack "receivers" {
  stack_name = sys.env("STACK_NAME")
  token      = sys.env("ACCESS_TOKEN")
}

// ── Alloy self-monitoring ─────────────────────────────────────────────────────
logging {
  level    = "info"
  format   = "logfmt"
  write_to = [loki.process.alloy.receiver]
}

loki.process "alloy" {
  forward_to = [grafana_cloud.stack.receivers.logs]

  stage.static_labels {
    values = {
      instance     = constants.hostname,
      job          = "integrations/alloy",
      service_name = "alloy",
    }
  }
}

prometheus.exporter.self "integrations_alloy_health" { }

discovery.relabel "integrations_alloy_health" {
  targets = prometheus.exporter.self.integrations_alloy_health.targets

  rule {
    replacement = constants.hostname
    target_label  = "instance"
  }

  rule {
    target_label = "job"
    replacement  = "integrations/alloy"
  }
}

prometheus.scrape "integrations_alloy_health" {
  forward_to      = [grafana_cloud.stack.receivers.metrics]
  targets         = discovery.relabel.integrations_alloy_health.output
  scrape_interval = "60s"
  job_name        = "integrations/alloy"
}

// ── Node metrics ──────────────────────────────────────────────────────────────
prometheus.exporter.unix "integrations_node_exporter" {
  procfs_path = "/host/proc"
  sysfs_path  = "/host/sys"

  disable_collectors = ["ipvs", "btrfs", "infiniband", "xfs", "zfs"]

  filesystem {
    fs_types_exclude     = "^(autofs|binfmt_misc|bpf|cgroup2?|configfs|debugfs|devpts|devtmpfs|tmpfs|fusectl|hugetlbfs|iso9660|mqueue|nsfs|overlay|proc|procfs|pstore|rpc_pipefs|securityfs|selinuxfs|squashfs|sysfs|tracefs)$"
    mount_points_exclude = "^/(dev|proc|run/credentials/.+|sys|var/lib/docker/.+)($|/)"
    mount_timeout        = "5s"
  }

  netclass {
    ignored_devices = "^(veth.*|cali.*|[a-f0-9]{15})$"
  }

  netdev {
    device_exclude = "^(veth.*|cali.*|[a-f0-9]{15})$"
  }
}

discovery.relabel "integrations_node_exporter" {
  targets = prometheus.exporter.unix.integrations_node_exporter.targets

  rule {
    target_label = "instance"
    replacement  = constants.hostname
  }
  rule {
    target_label = "job"
    replacement  = "integrations/node_exporter"
  }
}

prometheus.scrape "integrations_node_exporter" {
  targets         = discovery.relabel.integrations_node_exporter.output
  forward_to      = [prometheus.relabel.integrations_node_exporter.receiver]
  scrape_interval = "60s"
}

prometheus.relabel "integrations_node_exporter" {
  forward_to = [grafana_cloud.stack.receivers.metrics]

  rule {
    source_labels = ["__name__"]
    regex         = "node_scrape_collector_.+"
    action        = "drop"
  }
}

// ── Container metrics (cAdvisor) ──────────────────────────────────────────────
prometheus.exporter.cadvisor "integrations_cadvisor" {
  docker_host = "unix:///var/run/docker.sock"
  docker_only = true
}

discovery.relabel "integrations_cadvisor" {
  targets = prometheus.exporter.cadvisor.integrations_cadvisor.targets

  rule {
    target_label = "job"
    replacement  = "integrations/docker"
  }
  rule {
    target_label = "instance"
    replacement  = constants.hostname
  }
}

prometheus.scrape "integrations_cadvisor" {
  targets         = discovery.relabel.integrations_cadvisor.output
  forward_to      = [grafana_cloud.stack.receivers.metrics]
  scrape_interval = "60s"
}

// ── Systemd journal logs ──────────────────────────────────────────────────────
loki.source.journal "system" {
  path          = "/var/log/journal"
  forward_to    = [grafana_cloud.stack.receivers.logs]
  relabel_rules = loki.relabel.journal.rules

  labels = {
    job      = "integrations/linux",
    instance = constants.hostname,
  }
}

loki.relabel "journal" {
  forward_to = []

  rule {
    target_label = "service_name"
    replacement  = "linux"
  }
  rule {
    source_labels = ["__journal__systemd_unit"]
    target_label  = "unit"
  }
  rule {
    source_labels = ["__journal_priority_keyword"]
    target_label  = "level"
  }
  rule {
    source_labels = ["__journal__container_name"]
    target_label  = "container"
  }
}

// ── Docker container logs ─────────────────────────────────────────────────────
discovery.docker "logs_integrations_docker" {
  host             = "unix:///var/run/docker.sock"
  refresh_interval = "5s"
}

discovery.relabel "logs_integrations_docker" {
  targets = []

  // Alloy's own stdout is already captured by the dedicated logging{} block
  // (service_name="alloy"); dropping its container here avoids duplicate logs.
  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/observability[-_]alloy[-_].*"
    action        = "drop"
  }
  rule {
    target_label = "job"
    replacement  = "integrations/docker"
  }
  rule {
    target_label = "instance"
    replacement  = constants.hostname
  }
  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }
  // service_name = container name with any HAOS addon_<hash>_ prefix stripped.
  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(?:addon_[a-z0-9]+_)?(.*)"
    target_label  = "service_name"
    replacement   = "$1"
  }
  rule {
    source_labels = ["__meta_docker_container_log_stream"]
    target_label  = "stream"
  }
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "compose_service"
  }
}

loki.source.docker "logs_integrations_docker" {
  host             = "unix:///var/run/docker.sock"
  targets          = discovery.docker.logs_integrations_docker.targets
  forward_to       = [grafana_cloud.stack.receivers.logs]
  relabel_rules    = discovery.relabel.logs_integrations_docker.rules
  refresh_interval = "5s"
}

// ── Gather Home Assistant metrics ─────────────────────────────────────────────────────

prometheus.scrape "homeassistant" {
  forward_to = [grafana_cloud.stack.receivers.metrics]
  targets = [
    {
      "__address__" = "localhost:8123",
      "instance" = constants.hostname,
      "job" = "integrations/homeassistant",
    },
  ]
  scrape_interval = "60s"
  metrics_path = "/api/prometheus"
  bearer_token = env("HASS_METRICS_TOKEN")
  scheme = "http"
}

// ── Gather zigbee2mqtt metrics ────────────────────────────────────────────────
// Dev/edge zigbee2mqtt exposes a Prometheus endpoint on the host at :9142.
// Alloy uses host networking, so localhost reaches it (same as the HA scrape).
prometheus.scrape "zigbee2mqtt" {
  forward_to = [grafana_cloud.stack.receivers.metrics]
  targets = [
    {
      "__address__" = "localhost:9142",
      "instance"    = constants.hostname,
      "job"         = "integrations/zigbee2mqtt",
    },
  ]
  scrape_interval = "60s"
  metrics_path    = "/metrics"
  scheme          = "http"
}

// ── Gather Unpoller metrics ───────────────────────────────────────────────────
// Uses Docker SD to resolve the container's IP on the hassio network.
// The static hostname (addon_<hash>_unpoller) only resolves inside Docker
// networks; Alloy runs with host networking so DNS lookup fails.

discovery.docker "metrics_containers" {
  host             = "unix:///var/run/docker.sock"
  refresh_interval = "30s"
}

discovery.relabel "unpoller" {
  targets = discovery.docker.metrics_containers.targets

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/addon_[a-z0-9]+_unpoller"
    action        = "keep"
  }

  rule {
    source_labels = ["__meta_docker_network_name"]
    regex         = "hassio"
    action        = "keep"
  }

  rule {
    source_labels = ["__meta_docker_network_ip"]
    replacement   = "$1:9130"
    target_label  = "__address__"
  }

  rule {
    target_label = "job"
    replacement  = "integrations/unpoller"
  }

  rule {
    target_label = "instance"
    replacement  = constants.hostname
  }
}

prometheus.scrape "unpoller" {
  forward_to      = [grafana_cloud.stack.receivers.metrics]
  targets         = discovery.relabel.unpoller.output
  scrape_interval = "60s"
}

// ── UniFi gateway syslog ──────────────────────────────────────────────────────
// The UDM Pro Max's remote logging ("Activity Logging" / SIEM export) emits
// CEF over UDP, not RFC-compliant syslog: each datagram looks like
//   "Jun 17 12:42:00 <site name> CEF:0|Ubiquiti|UniFi ...|name|severity|..."
// with no <PRI> prefix, so the strict rfc3164/rfc5424 parsers reject it. We
// listen in "raw" mode (passes the whole datagram through unparsed) and forward
// the full line; loki.process below only extracts a few labels for querying.
//
// "raw" is an experimental Alloy feature, so the container runs with
// --stability.level=experimental (see docker-compose.yml).
//
// Alloy runs with host networking (and as root), so this listener is reachable
// on the LAN at <HA host>:514. Point the UDM's Remote Logging at
// 192.168.0.12:514 (UDP).

loki.source.syslog "unifi" {
  listener {
    address       = "0.0.0.0:514"
    protocol      = "udp"
    syslog_format = "raw"
    labels = {
      job          = "integrations/unifi",
      instance     = "udm",
      service_name = "unifi",
    }
  }
  forward_to = [loki.process.unifi.receiver]
}

// The single UDP/514 stream multiplexes four unrelated kinds of line. We split
// them into separate Loki streams with a low-cardinality "log_type" label so a
// query for, say, camera events is not buried under firewall flow logs:
//
//   log_type=firewall  kernel iptables per-flow logs  "[CUSTOM..._WAN-A/D-...] DESCR=..."
//   log_type=dns       CoreDNS query logs (JSON)      "coredns[...]: {...}"
//   log_type=cef       CEF activity events            "CEF:0|Ubiquiti|UniFi Protect|..."
//   log_type=system    everything else (UniFi-OS daemons: mcad, earlyoom, ...)
//
// High-cardinality fields (SRC/DST IPs, ports, domains) stay in the log body and
// are queried with |= / |~ — only bounded fields (rule/policy name, CEF header)
// become labels.
loki.process "unifi" {
  forward_to = [grafana_cloud.stack.receivers.logs]

  // Default; the content matches below override it for the recognised kinds.
  stage.static_labels {
    values = { log_type = "system" }
  }

  // CEF activity events (Protect cameras, Network, Access). Pull the
  // low-cardinality header fields for querying; the full raw line is kept as the
  // body. Header layout:
  // CEF:Version|Vendor|Product|Version|SignatureID|Name|Severity|Extension
  stage.match {
    selector = "{job=\"integrations/unifi\"} |= \"CEF:\""

    stage.regex {
      expression = "CEF:[^|]*\\|[^|]*\\|(?P<product>[^|]*)\\|[^|]*\\|[^|]*\\|(?P<name>[^|]*)\\|(?P<severity>[^|]*)\\|"
    }
    stage.labels {
      values = {
        product  = "product",
        name     = "name",
        severity = "severity",
      }
    }
    stage.static_labels {
      values = { log_type = "cef" }
    }
  }

  // Kernel firewall (iptables) per-flow logs from any policy with logging=true.
  // Capture the policy name (DESCR) as a bounded "rule" label; IPs stay in body.
  stage.match {
    selector = "{job=\"integrations/unifi\"} |= \"[CUSTOM\""

    stage.regex {
      expression = "\\[CUSTOM[0-9]*_WAN-[AD]-[0-9]+\\] DESCR=\"(?P<rule>[^\"]*)\""
    }
    stage.labels {
      values = { rule = "rule" }
    }
    stage.static_labels {
      values = { log_type = "firewall" }
    }
  }

  // CoreDNS query logs (JSON; currently only type=dnsAdBlock entries).
  stage.match {
    selector = "{job=\"integrations/unifi\"} |= \"coredns[\""

    stage.static_labels {
      values = { log_type = "dns" }
    }
  }
}

// ── AdGuard Home query log ────────────────────────────────────────────────────
// AdGuard Home (HA add-on a0d7b954_adguard) is the IOT DNS resolver. It has no
// native log export, so we tail its on-disk query log and ship it to Loki for
// permanent per-domain history — the add-on's own querylog.json is rotation- and
// retention-capped, so it is not durable storage. The add-on's data directory is
// bind-mounted read-only into Alloy at /adguard (see docker-compose.yml).
//
// Only the live querylog.json is matched (not the rotated querylog.json.1), so a
// rotation does not re-ingest the whole previous file. One JSON object per line:
//   {"T":...,"QH":"<domain>","QT":"A","IP":"<client>","Upstream":...,
//    "Result":{...},"Elapsed":...,"Cached":...}
// High-cardinality fields (domain QH, client IP) stay in the body — query with
//   {service_name="adguard"} | json
// e.g. per-client domains:  {service_name="adguard"} | json | IP="192.168.2.67"
local.file_match "adguard" {
  path_targets = [{
    __path__     = "/adguard/querylog.json",
    job          = "integrations/adguard",
    instance     = constants.hostname,
    service_name = "adguard",
  }]
}

loki.source.file "adguard" {
  targets    = local.file_match.adguard.targets
  forward_to = [loki.process.adguard.receiver]
}

loki.process "adguard" {
  forward_to = [grafana_cloud.stack.receivers.logs]

  // Use AdGuard's own query timestamp (T, RFC3339Nano) as the Loki timestamp so a
  // catch-up after Alloy downtime stamps entries with the real query time, not
  // the read time. Only extracts T; the full JSON line is kept as the body.
  stage.json {
    expressions = { ts = "T" }
  }
  stage.timestamp {
    source = "ts"
    format = "RFC3339Nano"
  }
}