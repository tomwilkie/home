                "range": true,
                "refId": "A"
              },
              {
                "datasource": {
                  "type": "prometheus",
                  "uid": "${prometheus_datasource}"
                },
                "editorMode": "code",
                "expr": "homeassistant_climate_current_temperature_celsius{entity=~\"climate\\\\.${area}_.*\"}",
                "legendFormat": "{{friendly_name}}",
                "range": true,
                "refId": "B"
              }
            ],
            "title": "$area temperatures",
            "type": "timeseries"
          }
        ],
        "repeat": "area",
        "repeatDirection": "v",
        "title": "$area",
        "type": "row"
