#!/usr/bin/env bash
set -euo pipefail

# Same variables as hass-cli; HOMEASSISTANT_* kept as a fallback.
BASE_URL="${HASS_SERVER:-${HOMEASSISTANT_URL:-}}"
TOKEN="${HASS_TOKEN:-${HOMEASSISTANT_TOKEN:-}}"

if [[ -z "$BASE_URL" || -z "$TOKEN" ]]; then
  echo "ha-api: set HASS_SERVER and HASS_TOKEN (see access-home-assistant.md)" >&2
  exit 1
fi

PATH_ARG="$1"
shift

curl -s \
  -H "Authorization: Bearer $TOKEN" \
  -H "Content-Type: application/json" \
  "${BASE_URL}${PATH_ARG}" \
  "$@"
